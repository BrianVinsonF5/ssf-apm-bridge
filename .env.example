# --- Server ---
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# --- Inbound TLS (this service's own listener) ---
# Set BOTH to serve https directly; leave BOTH empty to serve plaintext http.
# Setting only one is refused at start-up, and a configured-but-missing file
# exits non-zero instead of downgrading to cleartext (ADMIN_API_KEY travels
# in a header, so a silent downgrade would publish it in the clear).
#
# Required for the Kubernetes NodePort path -- a NodePort is L4 forwarding,
# so nothing in front of the container can terminate TLS on its behalf. In
# k8s these point at the cert-manager secret; see k8s/01-configmap.yaml.
# For a local test pair:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -subj "/CN=localhost" -addext "subjectAltName=DNS:localhost" \
#     -keyout dev-tls.key -out dev-tls.crt
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Storage backend for correlation store + decision cache ---
# "memory" needs nothing else and is fine for a single-process demo.
# "redis" is required once you run more than one bridge replica.
STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# --- Internal control-plane auth ---
# Required on: /admin/*, /correlation/*, /internal/decision/*
# This is what BIG-IP iRules and your admin tooling authenticate with.
# The service REFUSES TO START if this is left at the placeholder below, is
# shorter than 32 characters, or contains non-ASCII characters. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-to-a-long-random-value

# --- Custom CA Trust ---
# Path to custom CA root/intermediate bundle for trusting BIG-IP & Keycloak HTTPS
CA_BUNDLE_PATH=
SSL_CERT_FILE=

# Default TLS-verification policy for outbound calls to SSF transmitters
# (discovery, stream management, JWKS, polling). Individual transmitters can
# override this per-request with "verify_tls": false in the /admin/transmitters
# and /admin/transmitters/discover bodies, which is preferable to turning it
# off globally. Turning verification off lets anyone who can intercept the
# connection impersonate the transmitter and inject session-revocation events,
# so prefer populating CA_BUNDLE_PATH above. Lab use only.
SSF_VERIFY_TLS=true

# --- SSF receiver identity ---
# Publicly reachable base URL of THIS bridge, used when registering push
# delivery with a transmitter and as the SET verification callback target.
RECEIVER_BASE_URL=https://ssf-bridge.f5demos.com

# --- Replay / cache TTLs (seconds) ---
REPLAY_JTI_TTL_SECONDS=900
DECISION_CACHE_TTL_SECONDS=300
CORRELATION_TTL_SECONDS=86400

# --- SET freshness ---
# SETs carry no `exp` per the SSF spec, so `iat` age is the only bound on how
# long a captured SET stays replayable. Keep REPLAY_JTI_TTL_SECONDS >=
# SET_MAX_AGE_SECONDS so a SET can't become replayable again once its jti is
# forgotten but before it is considered stale.
SET_MAX_AGE_SECONDS=900
SET_CLOCK_SKEW_SECONDS=120

# --- BIG-IP APM (fast path) ---
BIGIP_HOST=bigip-apm.example.internal
BIGIP_PORT=443
BIGIP_USERNAME=ssf-bridge-svc
BIGIP_PASSWORD=change-me
BIGIP_VERIFY_TLS=true
# token = POST /mgmt/shared/authn/login then X-F5-Auth-Token (recommended)
# basic = HTTP Basic on every call (simpler for a lab box)
BIGIP_AUTH_MODE=token
# BIG-IP has no first-class REST resource for APM session termination, so the
# fast path runs `tmsh delete apm session key <id>` through the generic
# /mgmt/tm/util/bash endpoint. That requires "Advanced shell (bash)" access
# on BIGIP_USERNAME's role. See docs/apm-integration.md for the hardened
# alternative (iCall / custom REST worker) if your environment disallows that.
BIGIP_ENABLE_FAST_PATH=false
